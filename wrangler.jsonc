{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x1vi-product-catalogue",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
